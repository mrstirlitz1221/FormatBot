# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# База данных SQLite (путь относительно папки проекта)
DATABASE_URL=sqlite:///formatbot.db

# Максимальный размер входного файла. Облачный Bot API отдаёт ботам файлы до 20 МБ,
# поэтому значение выше 20 работает только вместе с TELEGRAM_API_URL (локальный Bot API Server).
MAX_FILE_SIZE_MB=20

# Папка для временных файлов задач
TEMP_DIR=./temp

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Необязательные параметры ---

# Сколько задач обрабатывается одновременно и сколько активных задач может быть у одного пользователя
# MAX_CONCURRENT_TASKS=2
# MAX_TASKS_PER_USER=2

# Максимальное время обработки одной задачи, секунд
# TASK_TIMEOUT_SEC=600

# Адрес локального Telegram Bot API Server (повышает лимиты файлов до 2000 МБ), например http://localhost:8081
# TELEGRAM_API_URL=

# Пути к внешним программам, если их нет в PATH
# FFMPEG_PATH=
# FFPROBE_PATH=
# SOFFICE_PATH=
# GHOSTSCRIPT_PATH=
